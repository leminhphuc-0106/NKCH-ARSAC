#include "Communication.h"
#include "ESP32Config.h"
#include "EncoderPCNT.h"
#include <cstdio>
#include <cstring>
#include <driver/uart.h>
#include <esp_timer.h>

using namespace std;
using CommunicationTypes::CommandType;

extern QueueHandle_t telemetryQueue;
QueueHandle_t highLevelCommandQueue = nullptr;
void send_status_text(const char *text) {
  uart_write_bytes(UART_PORT_NUM, text, std::strlen(text));
}

void communication_task(void *) {
  uint8_t byteIn = 0, packet[7] = {}, index = 0;
  char line[96] = {};
  size_t lineLength = 0;
  for (;;) {
    if (uart_read_bytes(UART_PORT_NUM, &byteIn, 1, pdMS_TO_TICKS(10)) == 1) {
      if (index == 0 && byteIn != 0xAA) {
        if (byteIn == '\n' || lineLength == sizeof(line) - 1) {
          line[lineLength] = '\0';
          Command command{};
          char keyword[8] = {};
          int parsed = std::sscanf(line, "%7s", keyword);
          if (parsed == 1 && std::strcmp(keyword, "HOME") == 0)
            command.type = CommandType::HOME;
          else if (parsed == 1 &&
                   std::sscanf(line, "POINT %d %d %d", &command.x1, &command.y1,
                               &command.z1) == 3)
            command.type = CommandType::POINT;
          else if (parsed == 1 &&
                   std::sscanf(line, "LINE %d %d %d TO %d %d %d", &command.x1,
                               &command.y1, &command.z1, &command.x2,
                               &command.y2, &command.z2) == 6)
            command.type = CommandType::LINE;
          else if (parsed == 1 &&
                   std::sscanf(line, "CIRCLE %d %d %d %d", &command.x1,
                               &command.y1, &command.z1, &command.radius) == 4)
            command.type = CommandType::CIRCLE;
          command.receivedAtMs =
              static_cast<uint32_t>(esp_timer_get_time() / 1000);
          if (parsed == 1 && highLevelCommandQueue != nullptr &&
              (std::strcmp(keyword, "HOME") == 0 ||
               command.type == CommandType::POINT ||
               command.type == CommandType::LINE ||
               command.type == CommandType::CIRCLE))
            xQueueSend(highLevelCommandQueue, &command, 0);
          lineLength = 0;
        } else if (byteIn != '\r')
          line[lineLength++] = static_cast<char>(byteIn);
        continue;
      }
      if ((index == 0 && byteIn != 0xAA) || (index == 1 && byteIn != 0x55)) {
        index = byteIn == 0xAA ? 1 : 0;
        continue;
      }
      packet[index++] = byteIn;
      if (index == sizeof(packet)) {
        const uint8_t checksum = packet[2] + packet[3] + packet[4] + packet[5];
        if (checksum == packet[6]) {
          DesiredCounts command{};
          command.count1 = static_cast<int16_t>((packet[2] << 8) | packet[3]);
          command.count2 = static_cast<int16_t>((packet[4] << 8) | packet[5]);
          command.receivedAtMs =
              static_cast<uint32_t>(esp_timer_get_time() / 1000);
          xQueueSend(cmdQueue, &command, 0);
        }
        index = 0;
      }
    }
    EncoderCounts counts{};
    while (telemetryQueue &&
           xQueueReceive(telemetryQueue, &counts, 0) == pdTRUE) {
      const int16_t c1 = static_cast<int16_t>(counts.count1);
      const int16_t c2 = static_cast<int16_t>(counts.count2);
      uint8_t frame[7] = {0x55,
                          0xAA,
                          static_cast<uint8_t>((c1 >> 8) & 0xFF),
                          static_cast<uint8_t>(c1 & 0xFF),
                          static_cast<uint8_t>((c2 >> 8) & 0xFF),
                          static_cast<uint8_t>(c2 & 0xFF),
                          0x00};
      frame[6] = frame[2] + frame[3] + frame[4] + frame[5];
      uart_write_bytes(UART_PORT_NUM, reinterpret_cast<const char *>(frame),
                       sizeof(frame));
    }
  }
}
